{
  "name": "@sb/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/node_modules/**' --exclude '**/*.integration.test.ts'",
    "gen:types": "supabase gen types typescript --local > src/types.ts",
    "test:integration": "pnpm --filter @sb/domain run build && vitest run integration",
    "bench:postgrest": "node scripts/bench-postgrest.mjs",
    "check:embeds": "node scripts/check-embeds.mjs",
    "report:health": "node scripts/report-health.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sb/config": "workspace:*",
    "@sb/domain": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "eslint": "10.8.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
